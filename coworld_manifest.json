{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "multiplayer",
    "competitive",
    "ants",
    "stigmergy",
    "foraging",
    "artificial-life"
  ],
  "game": {
    "name": "emerg-ant",
    "replay_viewer": {
      "bundle": "static-replay-viewer"
    },
    "description": "Emerg-ant is a 1v1 artificial-life colony duel. Each submitted policy controls a colony of connected copies: a fixed winged queen and seven workers start alive by default, with eight more copies waiting as brood. Every ant smells randomly replenishing neutral food, and each delivery to the queen hatches another copy. Public pheromones provide shared environmental memory. There are no guns or items: rivals fight only by physical contact, and killing a queen collapses her colony.",
    "owner": "treeform@softmax.com",
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": [
        "/bin/emerg-ant"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-emerg-ant/tree/main"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot, indexed by slot.",
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "players": {
          "description": "One player display-name object per player slot, indexed by slot.",
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "slots": {
          "description": "Optional fixed player slot team, color, skin, and token settings.",
          "type": "array",
          "maxItems": 32,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string"
              },
              "team": {
                "type": "string",
                "enum": [
                  "red",
                  "blue",
                  "green",
                  "yellow"
                ],
                "description": "Fixed team for this seat. Green and yellow are only valid when teams is 4; with no team the seat is dealt slot mod teams."
              },
              "skin": {
                "description": "Cosmetic body-art skin for this slot's player. Rendering only: no gameplay effect and no observation-label change.",
                "type": "string",
                "enum": [
                  "default",
                  "crown"
                ]
              },
              "color": {
                "type": "string",
                "enum": [
                  "red",
                  "orange",
                  "yellow",
                  "light blue",
                  "pink",
                  "lime",
                  "blue",
                  "pale blue",
                  "gray",
                  "white",
                  "dark brown",
                  "brown",
                  "dark teal",
                  "green",
                  "dark navy",
                  "black"
                ]
              }
            }
          }
        },
        "closedRoster": {
          "description": "Reject players outside the configured token/slot roster.",
          "type": "boolean",
          "default": false
        },
        "seed": {
          "description": "Random seed.",
          "type": "integer",
          "default": 679961
        },
        "minPlayers": {
          "description": "Players needed before the game countdown starts.",
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 32
        },
        "lives": {
          "description": "Lives per player. Out of lives = out for the round.",
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "hitPoints": {
          "description": "Hit points per life. In Emerg-ant each touching mandible strike removes one; at zero the ant dies.",
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "respawnTicks": {
          "description": "Ticks dead before respawning at home (~3s at 24 ticks/s).",
          "type": "integer",
          "minimum": 0,
          "default": 72
        },
        "gunRange": {
          "description": "CTF-only maximum hitscan gun range. Ignored in Emerg-ant, which has no ranged attacks.",
          "type": "integer",
          "minimum": 1,
          "default": 1300
        },
        "fireCooldownTicks": {
          "description": "Minimum ticks between attacks. In Emerg-ant this is the cooldown between physical mandible strikes.",
          "type": "integer",
          "minimum": 0,
          "default": 12
        },
        "carrierSpeedPct": {
          "description": "Movement speed percentage while carrying food (or a heart in CTF mode).",
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 70
        },
        "aimTurnRate": {
          "description": "Aim rotation speed in brads (256ths of a turn) per tick while a rotate button is held. B rotates counter-clockwise, Select clockwise; movement never changes the aim.",
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "visionConeDeg": {
          "description": "Vision cone half-angle in degrees around the aim angle. Fog of war hides everything outside the cone, the vision bubble, and line of sight.",
          "type": "integer",
          "minimum": 0,
          "maximum": 180,
          "default": 45
        },
        "visionBubble": {
          "description": "Omnidirectional vision radius in pixels around each player, seen regardless of aim.",
          "type": "integer",
          "minimum": 0,
          "default": 90
        },
        "startWaitTicks": {
          "description": "Lobby countdown ticks after enough players join.",
          "type": "integer",
          "minimum": 0,
          "default": 120
        },
        "lobbyJoinTimeoutTicks": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Finite matches only: abort the lobby when the roster is still short of minPlayers after this many lobby ticks (24 ticks = 1s), declaring the stuck seat via COGAME_PLAYER_FAILURE_URI so the platform charges the no-show to that policy. 0 = wait forever (default). The clock runs on lobby ticks, so board bake time never eats the budget."
        },
        "gameOverTicks": {
          "description": "Game over display duration in ticks.",
          "type": "integer",
          "minimum": 0,
          "default": 360
        },
        "maxTicks": {
          "description": "Maximum game ticks before tiebreak, where 0 means no limit.",
          "type": "integer",
          "minimum": 0,
          "default": 10000
        },
        "maxGames": {
          "description": "Maximum games before shutdown.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "showPlayerLabels": {
          "description": "Show player labels.",
          "type": "boolean",
          "default": true
        },
        "fastMode": {
          "description": "Advance frames early when all players report ready.",
          "type": "boolean",
          "default": true
        },
        "mapPath": {
          "description": "Arena map identifier (procedurally generated).",
          "type": "string",
          "default": "arena"
        },
        "num_agents": {
          "description": "Number of agent seats; must equal the player slot count. Used by the platform ladder service for block seating.",
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 32
        },
        "fireWindupTicks": {
          "description": "CTF-only ticks from trigger pull to the shot releasing. Ignored in Emerg-ant, which has no ranged attacks.",
          "type": "integer",
          "minimum": 0,
          "default": 5
        },
        "teams": {
          "description": "Active team count. CTF supports 2 or 4; emerg-ant requires 2 and is always a 1v1 policy match.",
          "type": "integer",
          "enum": [
            2,
            4
          ]
        },
        "mapLayout": {
          "description": "Generated-map layout lock: sides, corners, or plus. Empty draws corners/plus from the map seed for 4-team games.",
          "type": "string",
          "enum": [
            "sides",
            "corners",
            "plus"
          ]
        },
        "mapSeed": {
          "description": "Terrain seed for mapPath gen/pool; -1 derives from the per-episode game seed.",
          "type": "integer"
        },
        "scoring": {
          "description": "End-of-game reward rule. \"classic\": the winning team scores +1 per losing team and each loser -1. \"pot\": every team antes one point and the winning team takes the whole pot, the losing teams splitting the forfeit evenly - 2 teams pay +2/-2, 4 teams pay +4/-1/-1/-1.",
          "type": "string",
          "enum": [
            "classic",
            "pot"
          ],
          "default": "classic"
        },
        "gameMode": {
          "description": "Objective ruleset. ctf is single-capture elimination. emerg-ant is a 1v1 colony duel with globally scented random food, one fixed queen plus a configurable number of starting ants, one hatched reserve per delivery, queen-death collapse, public erasable pheromones, no items or ranged attacks, and touch-only combat.",
          "type": "string",
          "enum": [
            "ctf",
            "emerg-ant"
          ],
          "default": "ctf"
        },
        "forageGoal": {
          "description": "Emerg-ant food deliveries needed for a colony win. Every round has one winner; tied finishes compare food, living ants, colony health, contact kills, then replay-seed parity.",
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "startingAntsPerColony": {
          "description": "Emerg-ant policy copies alive per colony when play starts, including the fixed queen. Additional connected copies remain dormant brood and one hatches for each food delivery.",
          "type": "integer",
          "minimum": 2,
          "maximum": 16,
          "default": 8
        },
        "mapSize": {
          "description": "Generated-map size-class lock: small, standard, large, huge, or giant. Empty draws the size from the map seed.",
          "type": "string",
          "enum": [
            "small",
            "standard",
            "large",
            "huge",
            "giant"
          ]
        },
        "handicaps": {
          "description": "Per-team handicap that weakens a team, keyed by team name. Each value is 0..1: 0 = normal, 1 = 50% of shots miss, 1 life, 1 hit point, half max speed; values in between interpolate linearly. Omitted teams are unhandicapped. Intended for a league (e.g. Campaign) to level a dominating team.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "red": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "blue": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "green": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "yellow": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "mapSpec": {
          "description": "Full expanded map geometry (obstacles, trenches, endzones) as a JSON object. Pins an exact authored map — e.g. a campaign cell's custom organic terrain — overriding mapPath/mapSeed/mapSize. Same format the replay config carries.",
          "type": "object"
        },
        "perks": {
          "perkVocabulary": [
            {
              "id": "armor",
              "effect": "+1 max hp"
            },
            {
              "id": "scope",
              "effect": "50% tighter gun aim"
            },
            {
              "id": "grenade",
              "effect": "+25% throw range"
            },
            {
              "id": "thruster",
              "effect": "+10% max speed"
            },
            {
              "id": "luck",
              "effect": "10% of landed gun shots deal 2 damage"
            }
          ],
          "description": "Per-team perk buffs, keyed by team name. Vocabulary: armor (+1 max hp), scope (50% tighter gun aim), grenade (+25% throw range), thruster (+10% max speed), luck (10% of landed gun shots deal 2 damage) — magnitudes tunable via perkMods. A team's value is a flat array of perk names (the whole team shares them), an array of such arrays (per-policy groups for 2v2 seats, dealt to the team's distinct policies in join order), or an object keyed by policy name pinning each group to exactly that policy (unmatched policies get nothing). Omitted teams have no perks.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "red": {
              "type": [
                "array",
                "object"
              ]
            },
            "blue": {
              "type": [
                "array",
                "object"
              ]
            },
            "green": {
              "type": [
                "array",
                "object"
              ]
            },
            "yellow": {
              "type": [
                "array",
                "object"
              ]
            }
          }
        },
        "perkMods": {
          "description": "Perk magnitude overrides. Fractions are 0..1: scopeAim = fraction of aim deviation removed, grenadeRange/thrusterSpeed = extra range/speed, luckChance = chance a landed shot is lucky; armorHp/luckDamage are hit-point counts (0..100).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "armorHp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "scopeAim": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grenadeRange": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "thrusterSpeed": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "luckChance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "luckDamage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "barrierPickups": {
          "description": "CTF-only cardboard-barrier pickups per team. Ignored in Emerg-ant, where all items are absent.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "barrageMaxPerSec": {
          "description": "CTF-only grenade-barrage endgame rate. Ignored in Emerg-ant, where grenades and ranged damage are absent.",
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 0
        },
        "barrageStartPerSec": {
          "description": "Grenade-barrage launch rate at the latch, along the map edges, grenades/second.",
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "barrageStartSec": {
          "description": "Clock seconds remaining that latch the barrage on (30 = starts at 4:30 on a 5:00 clock).",
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "barrageSaturateSec": {
          "description": "Seconds from the latch until full saturation: whole board targeted at barrageMaxPerSec (30 = saturated exactly at 5:00 with the default start).",
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scores"
      ],
      "properties": {
        "names": {
          "description": "One player name or address per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "One scalar score per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "number"
          }
        },
        "win": {
          "description": "One win flag per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "boolean"
          }
        },
        "team": {
          "description": "One team name (red or blue) per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "kills": {
          "description": "One kill count per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "deaths": {
          "description": "One death count per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "captures": {
          "description": "One objective-delivery count per player slot (food deliveries in Emerg-ant, heart captures in CTF).",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-emerg-ant/blob/main/docs/PROTOCOL.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-emerg-ant/blob/main/docs/PROTOCOL.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-emerg-ant/blob/main/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "Rules",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-emerg-ant/blob/main/docs/RULES.md"
          }
        }
      ]
    }
  },
